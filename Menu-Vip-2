-- Vẽ Hitbox với skeleton chính xác theo cơ thể Roblox
local function DrawHitbox(target, index)
    if not target or not target.Parent then return end
    
    local character = target.Parent
    local humanoid = character:FindFirstChild("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if not rootPart or not humanoid or humanoid.Health <= 0 then return end
    
    if HighlightBoxes[index] then
        for _, drawing in ipairs(HighlightBoxes[index]) do
            drawing:Remove()
        end
    end
    HighlightBoxes[index] = {}
    
    -- Vẽ hitbox chính tại HumanoidRootPart
    local screenPos = Camera:WorldToScreenPoint(rootPart.Position)
    local boxSize = Config.Hitbox.HitboxSize * 10
    
    local box = CreateDrawing("Square", {
        Visible = true,
        Color = Config.Hitbox.HitboxColor,
        Transparency = Config.Hitbox.HitboxTransparency,
        Thickness = 2,
        Size = Vector2.new(boxSize, boxSize * 2),
        Position = Vector2.new(screenPos.X, screenPos.Y)
    })
    if box then
        table.insert(HighlightBoxes[index], box)
    end
    
    -- Vẽ skeleton chính xác theo cấu trúc Roblox R15/R6
    if Config.Hitbox.ShowSkeleton then
        -- Danh sách các kết nối xương chính xác cho cả R6 và R15
        local skeletonConnections = {
            -- Đầu và thân
            {"Head", "UpperTorso"},
            {"Head", "Neck"},
            {"Neck", "UpperTorso"},
            
            -- Thân trên và dưới
            {"UpperTorso", "LowerTorso"},
            {"LowerTorso", "HumanoidRootPart"},
            
            -- Tay trái
            {"UpperTorso", "LeftUpperArm"},
            {"LeftUpperArm", "LeftLowerArm"},
            {"LeftLowerArm", "LeftHand"},
            
            -- Tay phải
            {"UpperTorso", "RightUpperArm"},
            {"RightUpperArm", "RightLowerArm"},
            {"RightLowerArm", "RightHand"},
            
            -- Chân trái
            {"LowerTorso", "LeftUpperLeg"},
            {"LeftUpperLeg", "LeftLowerLeg"},
            {"LeftLowerLeg", "LeftFoot"},
            
            -- Chân phải
            {"LowerTorso", "RightUpperLeg"},
            {"RightUpperLeg", "RightLowerLeg"},
            {"RightLowerLeg", "RightFoot"},
            
            -- Kết nối vai (nếu có)
            {"Neck", "LeftShoulder"},
            {"Neck", "RightShoulder"},
            {"LeftShoulder", "LeftUpperArm"},
            {"RightShoulder", "RightUpperArm"},
            
            -- Kết nối hông (nếu có)
            {"HumanoidRootPart", "LeftHip"},
            {"HumanoidRootPart", "RightHip"},
            {"LeftHip", "LeftUpperLeg"},
            {"RightHip", "RightUpperLeg"}
        }
        
        for _, connection in ipairs(skeletonConnections) do
            local part1 = character:FindFirstChild(connection[1])
            local part2 = character:FindFirstChild(connection[2])
            
            if part1 and part2 then
                local screenPos1 = Camera:WorldToScreenPoint(part1.Position)
                local screenPos2 = Camera:WorldToScreenPoint(part2.Position)
                
                -- Chỉ vẽ nếu cả hai điểm đều nhìn thấy được
                if screenPos1.Z > 0 and screenPos2.Z > 0 then
                    local line = CreateDrawing("Line", {
                        Visible = true,
                        Color = Config.Hitbox.SkeletonColor,
                        Thickness = Config.Hitbox.SkeletonThickness,
                        From = Vector2.new(screenPos1.X, screenPos1.Y),
                        To = Vector2.new(screenPos2.X, screenPos2.Y)
                    })
                    if line then
                        table.insert(HighlightBoxes[index], line)
                    end
                end
            end
        end
        
        -- Vẽ các điểm khớp
        local jointParts = {
            "Head", "Neck", "UpperTorso", "LowerTorso", "HumanoidRootPart",
            "LeftShoulder", "RightShoulder",
            "LeftUpperArm", "LeftLowerArm", "LeftHand",
            "RightUpperArm", "RightLowerArm", "RightHand",
            "LeftHip", "RightHip",
            "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
            "RightUpperLeg", "RightLowerLeg", "RightFoot"
        }
        
        for _, partName in ipairs(jointParts) do
            local part = character:FindFirstChild(partName)
            if part then
                local jointScreenPos = Camera:WorldToScreenPoint(part.Position)
                if jointScreenPos.Z > 0 then
                    local jointDot = CreateDrawing("Circle", {
                        Visible = true,
                        Radius = 3,
                        Color = Config.Hitbox.SkeletonColor,
                        Transparency = 0.5,
                        Thickness = 1,
                        Position = Vector2.new(jointScreenPos.X, jointScreenPos.Y)
                    })
                    if jointDot then
                        table.insert(HighlightBoxes[index], jointDot)
                    end
                end
            end
        end
    end
end

