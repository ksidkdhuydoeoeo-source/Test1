-- Hàm lấy target
local function GetClosestTarget()
    local closestTarget = nil
    local closestDistance = Config.Aimbot.FOV
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if Config.Aimbot.TeamCheck and player.Team == LocalPlayer.Team then
                continue
            end
            
            local targetChar = player.Character
            local humanoid = targetChar:FindFirstChild("Humanoid")
            local targetPart = targetChar:FindFirstChild(Config.Aimbot.AimPart) or targetChar:FindFirstChild("Head")
            
            if humanoid and humanoid.Health > 0 and targetPart then
                local screenPos, onScreen = Camera:WorldToScreenPoint(targetPart.Position)
                
                if onScreen then
                    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    
                    if distance < closestDistance then
                        closestTarget = targetPart
                        closestDistance = distance
                    end
                end
            end
        end
    end
    
    return closestTarget
end

-- Hàm aim
local function AimAt(target)
    if not target then return end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local predictedPosition = target.Position
    
    if Config.Aimbot.SilentAim then
        Target = target
    else
        local lookAt = CFrame.lookAt(Camera.CFrame.Position, predictedPosition)
        if Config.Aimbot.Smoothness > 1 then
            local smooth = Config.Aimbot.Smoothness * 0.1
            Camera.CFrame = Camera.CFrame:Lerp(lookAt, smooth)
        else
            Camera.CFrame = lookAt
        end
    end
end

-- Vẽ FOV
local function DrawFOV()
    if FOVCircle then
        FOVCircle:Remove()
        FOVCircle = nil
    end
    
    if Config.Aimbot.ShowFOV then
        FOVCircle = CreateDrawing("Circle", {
            Visible = true,
            Radius = Config.Aimbot.FOV,
            Color = Color3.fromRGB(255, 255, 255),
            Transparency = 0.5,
            Thickness = 2,
            Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        })
    end
end

-- Vẽ Hitbox
local function DrawHitbox(target, index)
    if not target or not target.Parent then return end
    
    local character = target.Parent
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if not rootPart then return end
    
    if HighlightBoxes[index] then
        for _, drawing in ipairs(HighlightBoxes[index]) do
            drawing:Remove()
        end
    end
    HighlightBoxes[index] = {}
    
    local screenPos = Camera:WorldToScreenPoint(rootPart.Position)
    local boxSize = Config.Hitbox.HitboxSize * 10
    
    local box = CreateDrawing("Square", {
        Visible = true,
        Color = Color3.fromRGB(255, 0, 0),
        Transparency = 0.5,
        Thickness = 2,
        Size = Vector2.new(boxSize, boxSize * 2),
        Position = Vector2.new(screenPos.X, screenPos.Y)
    })
    if box then
        table.insert(HighlightBoxes[index], box)
    end
    
    if Config.Hitbox.ShowSkeleton then
        local connections = {
            {"Head", "UpperTorso"},
            {"UpperTorso", "LowerTorso"},
            {"UpperTorso", "LeftUpperArm"},
            {"LeftUpperArm", "LeftLowerArm"},
            {"UpperTorso", "RightUpperArm"},
            {"RightUpperArm", "RightLowerArm"},
            {"LowerTorso", "LeftUpperLeg"},
            {"LeftUpperLeg", "LeftLowerLeg"},
            {"LowerTorso", "RightUpperLeg"},
            {"RightUpperLeg", "RightLowerLeg"}
        }
        
        for _, connection in ipairs(connections) do
            local part1 = character:FindFirstChild(connection[1])
            local part2 = character:FindFirstChild(connection[2])
            
            if part1 and part2 then
                local screenPos1 = Camera:WorldToScreenPoint(part1.Position)
                local screenPos2 = Camera:WorldToScreenPoint(part2.Position)
                
                local line = CreateDrawing("Line", {
                    Visible = true,
                    Color = Color3.fromRGB(0, 255, 0),
                    Thickness = 2,
                    From = Vector2.new(screenPos1.X, screenPos1.Y),
                    To = Vector2.new(screenPos2.X, screenPos2.Y)
                })
                if line then
                    table.insert(HighlightBoxes[index], line)
                end
            end
        end
    end
end

-- Main Loop
local function MainLoop()
    -- Speed
    if Config.Speed.Enabled then
        local character = LocalPlayer.Character
        if character then
            local humanoid = character:FindFirstChild("Humanoid")
            if humanoid then
                humanoid.WalkSpeed = Config.Speed.SpeedValue
            end
        end
    end
    
    -- Aimbot
    if Config.Aimbot.Enabled then
        local isKeyPressed = UserInputService:IsKeyDown(Config.Aimbot.Keybind)
        
        if Config.Aimbot.ToggleMode then
            if isKeyPressed and not isAiming then
                isAiming = true
                wait(0.2)
            elseif isKeyPressed and isAiming then
                isAiming = false
                wait(0.2)
            end
        else
            isAiming = isKeyPressed
        end
        
        if isAiming then
            local target = GetClosestTarget()
            if target then
                AimAt(target)
                Target = target
            end
        end
    end
    
    -- Hitbox
    if Config.Hitbox.Enabled then
        for _, drawings in pairs(HighlightBoxes) do
            for _, drawing in ipairs(drawings) do
                drawing:Remove()
            end
        end
        HighlightBoxes = {}
        
        local index = 0
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local humanoid = player.Character:FindFirstChild("Humanoid")
                local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
                
                if humanoid and humanoid.Health > 0 and rootPart then
                    index += 1
                    DrawHitbox(rootPart, index)
                end
            end
        end
    end
    
    -- FOV
    if Config.Aimbot.ShowFOV and FOVCircle then
        FOVCircle.Radius = Config.Aimbot.FOV
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    end
end

-- Khởi tạo
local function Init()
    CreateUI()
    DrawFOV()
    
    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Config.UI.ToggleKey then
            if ScreenGui then
                ScreenGui.Enabled = not ScreenGui.Enabled
            end
        end
    end)
    
    RunService.RenderStepped:Connect(MainLoop)
    print("[Delta UI] Loaded!")
end

-- Chạy
Init()
