-- ESP SYSTEM
--==================================================

local ESPObjects = {}

local function removeESP(player)
    local data = ESPObjects[player]

    if not data then
        return
    end

    if data.Highlight then
        data.Highlight:Destroy()
    end

    if data.Billboard then
        data.Billboard:Destroy()
    end

    ESPObjects[player] = nil
end

local function createESP(player)
    if player == LocalPlayer then
        return
    end

    if not State.ESPEnabled then
        return
    end

    if not isEnemy(player) then
        return
    end

    local character = player.Character

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    local root =
        character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        return
    end

    removeESP(player)

    local highlight = Instance.new("Highlight")
    highlight.Name = "XiBoESP"
    highlight.Adornee = character
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillColor = Color3.fromRGB(220, 60, 60)
    highlight.FillTransparency = 0.78
    highlight.OutlineColor = Color3.fromRGB(255, 80, 80)
    highlight.OutlineTransparency = 0.1
    highlight.Parent = character

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "XiBoESPName"
    billboard.Adornee = root
    billboard.Size = UDim2.fromOffset(150, 30)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = character

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.fromScale(1, 1)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.DisplayName
    nameLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
    nameLabel.TextStrokeTransparency = 0.35
    nameLabel.TextSize = 13
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Parent = billboard

    ESPObjects[player] = {
        Highlight = highlight,
        Billboard = billboard,
    }
end

local function refreshESP()
    if not State.ESPEnabled then
        for player in pairs(ESPObjects) do
            removeESP(player)
        end

        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if isEnemy(player) then
                createESP(player)
            else
                removeESP(player)
            end
        end
    end
end

Players.PlayerRemoving:Connect(function(player)
    removeESP(player)
end)

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.5)

        if State.ESPEnabled then
            createESP(player)
        end
    end)
end)

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        player.CharacterAdded:Connect(function()
            task.wait(0.5)

            if State.ESPEnabled then
                createESP(player)
            end
        end)
    end
end

--==================================================
-- PERFORMANCE V3
--==================================================

local PerformanceBackup = {}
local PerformanceConnection = nil
local PerformanceScanRunning = false

local EFFECT_CLASSES = {
    ParticleEmitter = true,
    Trail = true,
    Beam = true,
    Smoke = true,
    Fire = true,
    Sparkles = true,

    BloomEffect = true,
    BlurEffect = true,
    DepthOfFieldEffect = true,
    SunRaysEffect = true,
    ColorCorrectionEffect = true,
}

local function backupProperty(instance, property)
    if not instance then
        return
    end

    PerformanceBackup[instance] =
        PerformanceBackup[instance] or {}

    if PerformanceBackup[instance][property] ~= nil then
        return
    end

    local success, value =
        pcall(function()
            return instance[property]
        end)

    if success then
        PerformanceBackup[instance][property] = value
    end
end

local function disableEffect(instance)
    if not EFFECT_CLASSES[instance.ClassName] then
        return
    end

    local success = pcall(function()
        backupProperty(instance, "Enabled")
        instance.Enabled = false
    end)

    return success
end

local function optimizeInstance(instance)
    if not State.PerformanceEnabled then
        return
    end

    disableEffect(instance)

    -- Client-only lighting optimizations.
    if instance == Lighting then
        backupProperty(Lighting, "GlobalShadows")
        backupProperty(Lighting, "EnvironmentDiffuseScale")
        backupProperty(Lighting, "EnvironmentSpecularScale")

        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.EnvironmentDiffuseScale = 0
            Lighting.EnvironmentSpecularScale = 0
        end)
    end
end

local function scanPerformance()
    if PerformanceScanRunning then
        return
    end

    if not State.PerformanceEnabled then
        return
    end

    PerformanceScanRunning = true

    local descendants = game:GetDescendants()

    for index, instance in ipairs(descendants) do
        if not State.PerformanceEnabled then
            break
        end

        optimizeInstance(instance)

        -- Yield periodically so the optimization scan
        -- does not freeze the client.
        if index % 250 == 0 then
            task.wait()
        end
    end

    PerformanceScanRunning = false
end

local function enablePerformance()
    if PerformanceConnection then
        PerformanceConnection:Disconnect()
        PerformanceConnection = nil
    end

    -- Lighting backup.
    backupProperty(Lighting, "GlobalShadows")
    backupProperty(Lighting, "EnvironmentDiffuseScale")
    backupProperty(Lighting, "EnvironmentSpecularScale")

    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
    end)

    State.PerformanceEnabled = true

    task.spawn(scanPerformance)

    PerformanceConnection =
        game.DescendantAdded:Connect(function(instance)
            if not State.PerformanceEnabled then
                return
            end

            task.defer(function()
                if State.PerformanceEnabled then
                    optimizeInstance(instance)
                end
            end)
        end)
end

local function disablePerformance()
    State.PerformanceEnabled = false

    if PerformanceConnection then
        PerformanceConnection:Disconnect()
        PerformanceConnection = nil
    end

    for instance, properties in pairs(PerformanceBackup) do
        if instance and instance.Parent then
            for property, value in pairs(properties) do
                pcall(function()
                    instance[property] = value
                end)
            end
        end
    end

    table.clear(PerformanceBackup)
end

