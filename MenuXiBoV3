--==================================================
-- MAIN LOOP
--==================================================

local espTimer = 0
local performanceTimer = 0

RunService.RenderStepped:Connect(function(deltaTime)
    ------------------------------------------------
    -- Movement
    ------------------------------------------------

    local humanoid = getHumanoid()

    if humanoid then
        if State.SpeedEnabled then
            humanoid.WalkSpeed = State.Speed
        end

        if State.JumpEnabled then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = State.JumpPower
        end
    end

    ------------------------------------------------
    -- No Clip
    ------------------------------------------------

    if State.NoClipEnabled then
        local character = getCharacter()

        if character then
            for _, instance in ipairs(character:GetDescendants()) do
                if instance:IsA("BasePart") then
                    instance.CanCollide = false
                end
            end
        end
    end

    ------------------------------------------------
    -- Aim
    ------------------------------------------------

    updateAim()

    ------------------------------------------------
    -- FOV
    ------------------------------------------------

    local camera = workspace.CurrentCamera

    if camera then
        local viewport = camera.ViewportSize

        FOVCircle.Position = UDim2.fromOffset(
            viewport.X / 2,
            viewport.Y / 2
        )

        -- Keep the visual indicator inside the viewport.
        local maxVisual =
            math.min(viewport.X, viewport.Y) * 0.45

        local visualSize =
            math.min(State.AimFOV, maxVisual)

        FOVCircle.Size =
            UDim2.fromOffset(
                visualSize * 2,
                visualSize * 2
            )

        FOVCircle.Visible = State.AimEnabled
    end

    ------------------------------------------------
    -- ESP
    ------------------------------------------------

    espTimer += deltaTime

    if espTimer >= CONFIG.ESPRefresh then
        espTimer = 0
        refreshESP()
    end

    ------------------------------------------------
    -- Performance maintenance
    ------------------------------------------------

    if State.PerformanceEnabled then
        performanceTimer += deltaTime

        if performanceTimer >= CONFIG.PerformanceScanInterval then
            performanceTimer = 0

            task.spawn(scanPerformance)
        end
    else
        performanceTimer = 0
    end
end)

--==================================================
-- PERFORMANCE TOGGLE MONITOR
--==================================================

task.spawn(function()
    local previous = false

    while ScreenGui.Parent do
        if State.PerformanceEnabled ~= previous then
            previous = State.PerformanceEnabled

            if State.PerformanceEnabled then
                enablePerformance()
            else
                disablePerformance()
            end
        end

        task.wait(0.15)
    end
end)

