-- Hàm kiểm tra line of sight
local function IsVisible(target)
    if not Config.Aimbot.WallCheck then return true end
    
    local character = LocalPlayer.Character
    if not character then return false end
    
    local origin = Camera.CFrame.Position
    local targetPos = target.Position
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {character}
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    
    local raycastResult = workspace:Raycast(origin, targetPos - origin, raycastParams)
    
    if raycastResult then
        return false
    end
    
    return true
end

-- Hàm lấy target gần nhất
local function GetClosestTarget()
    local closestTarget = nil
    local closestDistance = Config.Aimbot.FOV
    
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if Config.Aimbot.TeamCheck and player.Team == LocalPlayer.Team then
                continue
            end
            
            local targetChar = player.Character
            if targetChar and targetChar:FindFirstChild("Humanoid") and targetChar.Humanoid.Health > 0 then
                local targetPart = targetChar:FindFirstChild(Config.Aimbot.AimPart) or targetChar:FindFirstChild("Head")
                if targetPart then
                    local screenPos, onScreen = Camera:WorldToScreenPoint(targetPart.Position)
                    
                    if onScreen then
                        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                        local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        
                        if distance < closestDistance then
                            if IsVisible(targetPart) then
                                closestTarget = targetPart
                                closestDistance = distance
                            end
                        end
                    end
                end
            end
        end
    end
    
    return closestTarget
end

-- Hàm aim
local function AimAt(target)
    if not target then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local targetVelocity = Vector3.new(0, 0, 0)
    local targetHumanoid = target.Parent:FindFirstChild("Humanoid")
    local targetRoot = target.Parent:FindFirstChild("HumanoidRootPart")
    
    if targetHumanoid and targetRoot then
        targetVelocity = targetRoot.AssemblyLinearVelocity
    end
    
    local predictedPosition = target.Position + targetVelocity * Config.Aimbot.Prediction
    
    if Config.Aimbot.SilentAim then
        -- Silent aim - chỉ thay đổi hướng đạn (giả lập)
        local aimDirection = (predictedPosition - Camera.CFrame.Position).Unit
        -- Trong thực tế, silent aim cần hook vào remote events
        -- Đây là mô phỏng visual
        Target = target
    else
        local lookAt = CFrame.lookAt(Camera.CFrame.Position, predictedPosition)
        
        if Config.Aimbot.Smoothness > 1 then
            local smooth = Config.Aimbot.Smoothness * 0.1
            Camera.CFrame = Camera.CFrame:Lerp(lookAt, smooth)
        else
            Camera.CFrame = lookAt
        end
    end
end

-- Hàm vẽ FOV Circle
local function DrawFOV()
    if FOVCircle then
        FOVCircle:Remove()
    end
    
    if Config.Aimbot.ShowFOV then
        FOVCircle = Drawing.new("Circle")
        FOVCircle.Visible = true
        FOVCircle.Radius = Config.Aimbot.FOV
        FOVCircle.Color = Config.Aimbot.FOVColor
        FOVCircle.Transparency = Config.Aimbot.FOVTransparency
        FOVCircle.Thickness = 2
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    end
end

-- Hàm vẽ hitbox
local function DrawHitbox(target, index)
    if not target or not target.Parent then return end
    
    local character = target.Parent
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if not rootPart then return end
    
    -- Xóa hitbox cũ
    if HighlightBoxes[index] then
        HighlightBoxes[index]:Remove()
        HighlightBoxes[index] = nil
    end
    
    -- Vẽ hitbox 3D
    local box = Drawing.new("Square")
    box.Visible = true
    box.Color = Config.Hitbox.HitboxColor
    box.Transparency = Config.Hitbox.HitboxTransparency
    box.Thickness = 1
    box.Size = Vector2.new(Config.Hitbox.HitboxSize * 10, Config.Hitbox.HitboxSize * 20)
    
    -- Vẽ skeleton
    if Config.Hitbox.ShowSkeleton then
        local parts = {
            {"Head", "UpperTorso"},
            {"UpperTorso", "LowerTorso"},
            {"UpperTorso", "LeftUpperArm"},
            {"LeftUpperArm", "LeftLowerArm"},
            {"LeftLowerArm", "LeftHand"},
            {"UpperTorso", "RightUpperArm"},
            {"RightUpperArm", "RightLowerArm"},
            {"RightLowerArm", "RightHand"},
            {"LowerTorso", "LeftUpperLeg"},
            {"LeftUpperLeg", "LeftLowerLeg"},
            {"LeftLowerLeg", "LeftFoot"},
            {"LowerTorso", "RightUpperLeg"},
            {"RightUpperLeg", "RightLowerLeg"},
            {"RightLowerLeg", "RightFoot"}
        }
        
        for i, connection in ipairs(parts) do
            local part1 = character:FindFirstChild(connection[1])
            local part2 = character:FindFirstChild(connection[2])
            
            if part1 and part2 then
                local line = Drawing.new("Line")
                line.Visible = true
                line.Color = Config.Hitbox.SkeletonColor
                line.Thickness = Config.Hitbox.SkeletonThickness
                
                local screenPos1 = Camera:WorldToScreenPoint(part1.Position)
                local screenPos2 = Camera:WorldToScreenPoint(part2.Position)
                
                line.From = Vector2.new(screenPos1.X, screenPos1.Y)
                line.To = Vector2.new(screenPos2.X, screenPos2.Y)
                
                SkeletonDrawings[#SkeletonDrawings + 1] = line
            end
        end
    end
    
    HighlightBoxes[index] = box
    
    -- Cập nhật vị trí box
    local screenPos = Camera:WorldToScreenPoint(rootPart.Position)
    box.Position = Vector2.new(screenPos.X, screenPos.Y)
    
    -- Hiển thị khoảng cách
    if Config.Hitbox.ShowDistance then
        local distance = (rootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
        local distanceText = Drawing.new("Text")
        distanceText.Visible = true
        distanceText.Text = string.format("%.1f m", distance)
        distanceText.Color = Color3.fromRGB(255, 255, 255)
        distanceText.Size = 15
        distanceText.Position = Vector2.new(screenPos.X, screenPos.Y - 50)
        distanceText.Center = true
        distanceText.Outline = true
        
        if not HighlightBoxes[index .. "_text"] then
            HighlightBoxes[index .. "_text"] = distanceText
        end
    end
end

-- Main Loop
local function MainLoop()
    -- Speed
    if Config.Speed.Enabled and LocalPlayer.Character then
        local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = Config.Speed.SpeedValue
        end
    end
    
    -- Aimbot
    if Config.Aimbot.Enabled then
        local isKeyPressed = UserInputService:IsKeyDown(Config.Aimbot.Keybind)
        
        if Config.Aimbot.ToggleMode then
            -- Toggle mode
            if isKeyPressed and not isAiming then
                isAiming = true
                wait(0.1) -- Debounce
            elseif isKeyPressed and isAiming then
                isAiming = false
                wait(0.1)
            end
        else
            isAiming = isKeyPressed
        end
        
        if isAiming then
            local target = GetClosestTarget()
            if target then
                AimAt(target)
                Target = target
                
                -- Vẽ hitbox cho target
                if Config.Hitbox.Enabled and Config.Hitbox.TargetOnly then
                    for i = 1, #Players:GetPlayers() do
                        if HighlightBoxes[i] then
                            HighlightBoxes[i]:Remove()
                            HighlightBoxes[i] = nil
                        end
                    end
                    for i, line in ipairs(SkeletonDrawings) do
                        line:Remove()
                    end
                    SkeletonDrawings = {}
                    
                    DrawHitbox(target, 1)
                end
            end
        end
    end
    
    -- Hitbox cho tất cả player
    if Config.Hitbox.Enabled and not Config.Hitbox.TargetOnly then
        local players = Players:GetPlayers()
        for i, player in ipairs(players) do
            if player ~= LocalPlayer and player.Character then
                local targetPart = player.Character:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    DrawHitbox(targetPart, i)
                end
            end
        end
    end
    
    -- Cập nhật FOV
    if Config.Aimbot.ShowFOV and FOVCircle then
        FOVCircle.Radius = Config.Aimbot.FOV
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    end
end

-- Khởi tạo
local function Init()
    local UI = DeltaUI:CreateUI()
    DrawFOV()
    
    -- Kết nối Input
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if input.KeyCode == Config.UI.ToggleKey then
            UI.MainFrame.Visible = not UI.MainFrame.Visible
        end
    end)
    
    -- Chạy main loop
    RunService.RenderStepped:Connect(MainLoop)
end

-- Bắt đầu
Init()

return DeltaUI
