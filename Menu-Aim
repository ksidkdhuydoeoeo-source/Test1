-- Cache cho hiệu suất
local DrawingCache = {}
local function GetDrawing(className, properties)
    local key = className .. json.encode(properties or {})
    if not DrawingCache[key] then
        local drawing = Drawing.new(className)
        for prop, value in pairs(properties or {}) do
            drawing[prop] = value
        end
        DrawingCache[key] = drawing
    end
    return DrawingCache[key]
end

