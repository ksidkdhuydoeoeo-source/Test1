local function GetClosestTarget()
    local closest, closestDist = nil, Config.Aimbot.FOV
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hum = plr.Character:FindFirstChild("Humanoid")
            local part = plr.Character:FindFirstChild(Config.Aimbot.AimPart) or plr.Character:FindFirstChild("Head")
            if hum and hum.Health > 0 and part then
                local pos, onScreen = Camera:WorldToScreenPoint(part.Position)
                if onScreen then
                    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local screenDist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if screenDist < closestDist then
                        closest, closestDist = part, screenDist
                    end
                end
            end
        end
    end
    return closest
end

local function AimAt(target)
    if not target then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    if Config.Aimbot.SilentAim then
        Target = target
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
    else
        local lookAt = CFrame.lookAt(Camera.CFrame.Position, target.Position)
        if Config.Aimbot.Smoothness > 1 then
            Camera.CFrame = Camera.CFrame:Lerp(lookAt, Config.Aimbot.Smoothness * 0.05)
        else
            Camera.CFrame = lookAt
        end
    end
end

local function DrawFOV()
    if FOVCircle then pcall(function() FOVCircle:Remove() end) FOVCircle = nil end
    if Config.Aimbot.ShowFOV then
        FOVCircle = CreateDrawing("Circle", {
            Visible = true, Radius = Config.Aimbot.FOV,
            Color = Color3.fromRGB(255, 255, 255), Transparency = 0.5, Thickness = 2,
            Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        })
    end
end

local function DrawHitbox(target, index)
    if not target or not target.Parent then return end
    local char = target.Parent
    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root or not hum or hum.Health <= 0 then return end
    
    if HighlightBoxes[index] then
        for _, d in ipairs(HighlightBoxes[index]) do pcall(function() d:Remove() end) end
    end
    HighlightBoxes[index] = {}
    
    local pos = Camera:WorldToScreenPoint(root.Position)
    local size = Config.Hitbox.HitboxSize * 10
    local box = CreateDrawing("Square", {
        Visible = true, Color = Color3.fromRGB(255, 0, 0), Transparency = 0.4, Thickness = 3,
        Size = Vector2.new(size, size * 2), Position = Vector2.new(pos.X, pos.Y)
    })
    if box then table.insert(HighlightBoxes[index], box) end
    
    if Config.Hitbox.ShowSkeleton then
        local connections = {
            {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"}, {"LowerTorso", "HumanoidRootPart"},
            {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
            {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
            {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
            {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
            {"Head", "HumanoidRootPart"}
        }
        for _, conn in ipairs(connections) do
            local p1, p2 = char:FindFirstChild(conn[1]), char:FindFirstChild(conn[2])
            if p1 and p2 then
                local sp1, sp2 = Camera:WorldToScreenPoint(p1.Position), Camera:WorldToScreenPoint(p2.Position)
                if sp1.Z > 0 and sp2.Z > 0 then
                    local line = CreateDrawing("Line", {
                        Visible = true, Color = Color3.fromRGB(0, 255, 0), Thickness = 2,
                        From = Vector2.new(sp1.X, sp1.Y), To = Vector2.new(sp2.X, sp2.Y)
                    })
                    if line then table.insert(HighlightBoxes[index], line) end
                end
            end
        end
    end
end

local function MainLoop()
    if Config.Speed.Enabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then 
            hum.WalkSpeed = Config.Speed.SpeedValue
        end
    end
    
    if Config.Aimbot.Enabled then
        local target = GetClosestTarget()
        if target then 
            AimAt(target) 
            Target = target
        end
    end
    
    if Config.Hitbox.Enabled then
        for _, drawings in pairs(HighlightBoxes) do
            for _, d in ipairs(drawings) do pcall(function() d:Remove() end) end
        end
        HighlightBoxes = {}
        local index = 0
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hum = plr.Character:FindFirstChild("Humanoid")
                local root = plr.Character:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and root then
                    index += 1
                    DrawHitbox(root, index)
                end
            end
        end
    end
    
    if Config.Aimbot.ShowFOV and FOVCircle then
        pcall(function()
            FOVCircle.Radius = Config.Aimbot.FOV
            FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        end)
    end
end

pcall(CreateUI)
pcall(DrawFOV)

RunService.RenderStepped:Connect(MainLoop)

