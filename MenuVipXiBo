createSection("PERFORMANCE")

local function remember(instance, property)
    PerformanceBackup[instance] =
        PerformanceBackup[instance] or {}

    if PerformanceBackup[instance][property] == nil then
        PerformanceBackup[instance][property] =
            instance[property]
    end
end

local function optimizeObject(object)
    if not State.PerformanceEnabled then
        return
    end

    if object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Beam")
        or object:IsA("Smoke")
        or object:IsA("Fire")
        or object:IsA("Sparkles") then

        remember(object, "Enabled")
        object.Enabled = false

    elseif object:IsA("BloomEffect")
        or object:IsA("BlurEffect")
        or object:IsA("DepthOfFieldEffect")
        or object:IsA("SunRaysEffect")
        or object:IsA("ColorCorrectionEffect") then

        remember(object, "Enabled")
        object.Enabled = false
    end
end

local function enablePerformanceMode()
    if State.PerformanceEnabled then
        return
    end

    State.PerformanceEnabled = true

    local Lighting = game:GetService("Lighting")

    remember(Lighting, "GlobalShadows")
    remember(Lighting, "FogEnd")
    remember(Lighting, "EnvironmentDiffuseScale")
    remember(Lighting, "EnvironmentSpecularScale")

    Lighting.GlobalShadows = false
    Lighting.FogEnd = 100000
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0

    for _, object in ipairs(game:GetDescendants()) do
        optimizeObject(object)
    end

    PerformanceConnections.DescendantAdded =
        game.DescendantAdded:Connect(function(object)
            optimizeObject(object)
        end)
end

local function disablePerformanceMode()
    if not State.PerformanceEnabled then
        return
    end

    State.PerformanceEnabled = false

    for _, connection in pairs(PerformanceConnections) do
        connection:Disconnect()
    end

    table.clear(PerformanceConnections)

    for instance, properties in pairs(PerformanceBackup) do
        if instance and instance.Parent then
            for property, value in pairs(properties) do
                pcall(function()
                    instance[property] = value
                end)
            end
        end
    end

    table.clear(PerformanceBackup)
end

createToggle(
    "Ultra Performance",
    "Disable unnecessary effects & shadows",
    function(enabled)
        if enabled then
            enablePerformanceMode()
        else
            disablePerformanceMode()
        end
    end
)

--==================================================
-- TARGETING
--==================================================

local function isEnemy(player)
    if player == LocalPlayer then
        return false
    end

    if LocalPlayer.Team ~= nil
        and player.Team ~= nil then

        return LocalPlayer.Team ~= player.Team
    end

    return true
end

local function getTargetPart(player)
    local character = player.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("Head")
        or character:FindFirstChild("HumanoidRootPart")
end

local function hasLineOfSight(targetPart)
    Camera = workspace.CurrentCamera

    if not Camera then
        return false
    end

    local character = LocalPlayer.Character

    if not character then
        return false
    end

    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin

    local params = RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    params.FilterDescendantsInstances = {
        character
    }

    params.IgnoreWater = true

    local result =
        workspace:Raycast(
            origin,
            direction,
            params
        )

    if not result then
        return true
    end

    return result.Instance:IsDescendantOf(
        targetPart.Parent
    )
end

local function getClosestVisibleEnemy()
    Camera = workspace.CurrentCamera

    if not Camera then
        return nil
    end

    local viewport = Camera.ViewportSize

    local center =
        Vector2.new(
            viewport.X / 2,
            viewport.Y / 2
        )

    local closestPlayer = nil
    local closestScore = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local humanoid = getHumanoid(player)
            local targetPart = getTargetPart(player)

            if humanoid
                and humanoid.Health > 0
                and targetPart then

                local screenPosition, onScreen =
                    Camera:WorldToViewportPoint(
                        targetPart.Position
                    )

                if onScreen and screenPosition.Z > 0 then
                    local point =
                        Vector2.new(
                            screenPosition.X,
                            screenPosition.Y
                        )

                    local screenDistance =
                        (point - center).Magnitude

                    if screenDistance <= State.AimFOV
                        and hasLineOfSight(targetPart) then

                        local localRoot =
                            getRoot(LocalPlayer)

                        local targetRoot =
                            getRoot(player)

                        local worldDistance = 0

                        if localRoot and targetRoot then
                            worldDistance =
                                (
                                    localRoot.Position
                                    - targetRoot.Position
                                ).Magnitude
                        end

                        local score =
                            screenDistance
                            + math.min(
                                worldDistance,
                                500
                            ) * 0.01

                        if score < closestScore then
                            closestScore = score
                            closestPlayer = player
                        end
                    end
                end
            end
        end
    end

    return closestPlayer
end

