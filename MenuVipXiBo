local function updateFOVCircle()
    Camera = workspace.CurrentCamera

    if not Camera then
        return
    end

    local viewport = Camera.ViewportSize

    local maxRadius =
        math.min(viewport.X, viewport.Y) * 0.45

    local radius =
        math.clamp(
            State.AimFOV,
            20,
            maxRadius
