-- RESPONSIVE SCALE
--========================================================

local UIScale = create("UIScale", {
    Scale = 1,
}, Main)

local function updateScale()
    local viewport = Camera.ViewportSize

    local scaleX = viewport.X / CONFIG.DesktopWidth
    local scaleY = viewport.Y / CONFIG.DesktopHeight

    local targetScale = math.min(
        1,
        scaleX * 0.90,
        scaleY * 0.90
    )

    if viewport.X <= 600 then
        targetScale = math.min(
            1,
            viewport.X / CONFIG.MobileWidth * 0.92,
            viewport.Y / CONFIG.MobileHeight * 0.88
        )
    end

    UIScale.Scale = math.max(
        0.55,
        targetScale
    )
end

updateScale()

table.insert(
    Connections,
    Camera:GetPropertyChangedSignal("ViewportSize"):Connect(
        updateScale
    )
)

