        Name = "Toggle",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.fromOffset(42, 23),
        BackgroundColor3 =
            initial
            and COLORS.ToggleOn
            or COLORS.ToggleOff,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    }, holder)

    corner(toggle, 12)

    local knob = create("Frame", {
        Name = "Knob",
        AnchorPoint = Vector2.new(0, 0.5),
        Position =
            initial
            and UDim2.new(1, -21, 0.5, 0)
            or UDim2.new(0, 4, 0.5, 0),
        Size = UDim2.fromOffset(15, 15),
        BackgroundColor3 = COLORS.Text,
        BorderSizePixel = 0,
    }, toggle)

    corner(knob, 10)

    local enabled = initial

    local function update(value)
        enabled = value

        toggle.BackgroundColor3 =
            enabled
            and COLORS.ToggleOn
            or COLORS.ToggleOff

        knob.Position =
            enabled
            and UDim2.new(1, -21, 0.5, 0)
            or UDim2.new(0, 4, 0.5, 0)

        if callback then
            callback(enabled)
        end
    end

    toggle.Activated:Connect(function()
        update(not enabled)
    end)

    return {
        Set = update,
        Get = function()
            return enabled
        end,
    }
end

