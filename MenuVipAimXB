        end
    end
)

local function updateNoClip()
    if not State.NoClipEnabled
        or not Character then

        return
    end

    for _, part in ipairs(
        Character:GetDescendants()
    ) do

        if part:IsA("BasePart") then
            if NoClipBackup[part] == nil then
                NoClipBackup[part] =
                    part.CanCollide
            end

            part.CanCollide = false
        end
    end
end

