--========================================================
-- CREATE ESP
--========================================================

local function createESP(player)
    if player == LocalPlayer then
        return
    end

    local character =
        player.Character

    if not character then
        destroyESP(player)
        return
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid
        or humanoid.Health <= 0 then

        destroyESP(player)
        return
    end

    destroyESP(player)

    local data = {
        NameGui = nil,
        Bones = {},
        Direction = nil,
    }

    if State.ESPNameEnabled then
        data.NameGui =
            createNameESP(
                player,
                character
            )
    end

    if State.ESPBonesEnabled then
        data.Bones =
            createBones(
                player,
                character
            )
    end

    if State.ESPDirectionsEnabled then
        data.Direction =
            createDirectionESP(
                player,
                character
            )
    end

    ESPObjects[player] = data
end

local function refreshESP()
    local enabled =
        State.ESPNameEnabled
        or State.ESPBonesEnabled
        or State.ESPDirectionsEnabled

    if not enabled then
        for player in pairs(
            ESPObjects
        ) do
            destroyESP(player)
        end

        return
    end

    for _, player in ipairs(
        Players:GetPlayers()
    ) do
        if player ~= LocalPlayer then
            createESP(player)
        end
    end
end

