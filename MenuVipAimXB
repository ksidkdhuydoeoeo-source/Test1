}

local function createBoneLine(
    partA,
    partB,
    index
)
    if not partA
        or not partB
        or not partA:IsA("BasePart")
        or not partB:IsA("BasePart") then

        return {}
    end

    local attachmentA =
        Instance.new("Attachment")

    attachmentA.Name =
        "XiBoBoneA_" .. index

    attachmentA.Position =
        Vector3.zero

    attachmentA.Parent = partA

    local attachmentB =
        Instance.new("Attachment")

    attachmentB.Name =
        "XiBoBoneB_" .. index

    attachmentB.Position =
        Vector3.zero

    attachmentB.Parent = partB

    local beam =
        Instance.new("Beam")

    beam.Name =
        "XiBoBone_" .. index

    beam.Attachment0 =
        attachmentA

    beam.Attachment1 =
        attachmentB

    beam.FaceCamera = true
    beam.Width0 = 0.06
    beam.Width1 = 0.06

    beam.Color =
        ColorSequence.new(
            Color3.fromRGB(
                255,
                255,
                255
            )
        )

    beam.Transparency =
        NumberSequence.new(0)

    beam.LightEmission = 1
    beam.Parent = ESPFolder

    return {
        beam,
        attachmentA,
        attachmentB,
    }
end

local function createBones(
    player,
    character
)
    if not State.ESPBonesEnabled then
        return {}
    end

    local list

    if character:FindFirstChild(
        "UpperTorso"
    ) then
        list = R15_BONES
    else
        list = R6_BONES
    end

    local bones = {}

    for index, pair in ipairs(list) do
        local partA =
            character:FindFirstChild(
                pair[1]
            )

        local partB =
            character:FindFirstChild(
                pair[2]
            )

        if partA and partB then
            local objects =
                createBoneLine(
                    partA,
                    partB,
                    index
                )

            for _, object in ipairs(
                objects
            ) do
                table.insert(
                    bones,
                    object
                )
            end
        end
    end

    return bones
end

