            TextColor3 =
                COLORS.Accent,

            TextXAlignment =
                Enum.TextXAlignment.Right,

            ZIndex = 15,
        },
        holder
    )

    local bar = create(
        "Frame",
        {
            Position =
                UDim2.fromOffset(
                    14,
                    43
                ),

            Size =
                UDim2.new(
                    1,
                    -28,
                    0,
                    6
                ),

            BackgroundColor3 =
                COLORS.ToggleOff,

            BorderSizePixel = 0,

            Active = true,

            ZIndex = 16,
        },
        holder
    )

    addCorner(
        bar,
        5
    )

    local alpha =
        (initial - minimum)
        / (maximum - minimum)

    local fill = create(
        "Frame",
        {
            Size =
                UDim2.fromScale(
                    alpha,
                    1
                ),

            BackgroundColor3 =
                COLORS.Accent,

            BorderSizePixel = 0,

            ZIndex = 17,
        },
        bar
    )

    addCorner(
        fill,
        5
    )

    local knob = create(
        "Frame",
        {
            AnchorPoint =
                Vector2.new(
                    0.5,
                    0.5
                ),

            Position =
                UDim2.new(
                    alpha,
                    0,
                    0.5,
                    0
                ),

            Size =
                UDim2.fromOffset(
                    13,
                    13
                ),

            BackgroundColor3 =
                COLORS.Text,

            BorderSizePixel = 0,

            ZIndex = 18,
        },
        bar
    )

    addCorner(
        knob,
        10
    )

    local value =
        initial

    local sliderDragging =
        false

    local function setValue(newValue)

        value =
            clamp(
                math.floor(
                    newValue + 0.5
                ),
                minimum,
                maximum
            )

        local percentage =
            (
                value - minimum
            )
            / (
                maximum - minimum
            )

        fill.Size =
            UDim2.fromScale(
                percentage,
                1
            )

        knob.Position =
            UDim2.new(
                percentage,
                0,
                0.5,
                0
            )

        valueLabel.Text =
            tostring(value)

        if callback then
            local ok, err =
                pcall(
                    callback,
                    value
                )

            if not ok then
                warn(
                    "[XiBoDzV6] Slider error:",
                    err
                )
            end
        end
    end

    local function setFromInput(input)

        local left =
            bar.AbsolutePosition.X

        local width =
            bar.AbsoluteSize.X

        if width <= 0 then
            return
        end

        local percentage =
            math.clamp(
                (
                    input.Position.X
                    - left
                )
                / width,
                0,
                1
            )

        setValue(
            minimum
            + (
                maximum
                - minimum
            )
            * percentage
        )
    end

    bar.InputBegan:Connect(
        function(input)

            if input.UserInputType
                == Enum.UserInputType.MouseButton1
                or input.UserInputType
                == Enum.UserInputType.Touch then

                sliderDragging = true

                setFromInput(input)
            end
        end
    )

    UserInputService.InputChanged:Connect(
        function(input)

            if not sliderDragging then
                return
            end

            if input.UserInputType
                == Enum.UserInputType.MouseMovement
                or input.UserInputType
                == Enum.UserInputType.Touch then

                setFromInput(input)
            end
        end
    )

    UserInputService.InputEnded:Connect(
        function(input)

            if input.UserInputType
                == Enum.UserInputType.MouseButton1
                or input.UserInputType
                == Enum.UserInputType.Touch then

                sliderDragging = false
            end
        end
    )

    return {
        Set = setValue,

        Get = function()
            return value
        end,
    }
end

