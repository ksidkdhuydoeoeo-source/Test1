--========================================================
-- PAGE / TAB SYSTEM
--========================================================

local Tabs = {}
local Pages = {}
local CurrentTab

local function createPage(name)

    local page = create(
        "ScrollingFrame",
        {
            Name =
                name .. "Page",

            Size =
                UDim2.fromScale(
                    1,
                    1
                ),

            BackgroundTransparency = 1,

            BorderSizePixel = 0,

            ScrollBarThickness = 3,

            ScrollBarImageColor3 =
                COLORS.Accent,

            CanvasSize =
                UDim2.new(
                    0,
                    0,
                    0,
                    0
                ),

            AutomaticCanvasSize =
                Enum.AutomaticSize.Y,

            Visible = false,

            Active = true,

            ZIndex = 13,
        },
        PageContainer
    )

    create("UIPadding", {
        PaddingTop =
            UDim.new(0, 15),

        PaddingBottom =
            UDim.new(0, 15),

        PaddingLeft =
            UDim.new(0, 18),

        PaddingRight =
            UDim.new(0, 18),
    }, page)

    create("UIListLayout", {
        Padding =
            UDim.new(0, 10),

        SortOrder =
            Enum.SortOrder.LayoutOrder,
    }, page)

    Pages[name] = page

    return page
end

local function selectTab(name)

    local selectedPage =
        Pages[name]

    local selectedTab =
        Tabs[name]

    if not selectedPage
        or not selectedTab then

        return
    end

    CurrentTab = name

    for pageName, page in pairs(
        Pages
    ) do

        page.Visible =
            pageName == name
    end

    for tabName, tab in pairs(
        Tabs
    ) do

        local selected =
            tabName == name

        tab.BackgroundColor3 =
            selected
            and COLORS.AccentDark
            or COLORS.Sidebar

        local icon =
            tab:FindFirstChild(
                "Icon"
            )

        local label =
            tab:FindFirstChild(
                "Label"
            )

        if icon then
            icon.TextColor3 =
                selected
                and COLORS.Text
                or COLORS.SubText
        end

        if label then
            label.TextColor3 =
                selected
                and COLORS.Text
                or COLORS.SubText
        end
    end
end

