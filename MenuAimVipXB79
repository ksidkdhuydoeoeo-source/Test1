local function restoreNoClip()

    for part, original in pairs(
        NoClipBackup
    ) do

        if part
            and part.Parent
            and part:IsA("BasePart") then

            part.CanCollide =
                original
        end
    end

    table.clear(
        NoClipBackup
    )
end

local function updateNoClip()

    if not State.NoClipEnabled
        or not Character then

        return
    end

    for _, part in ipairs(
        Character:GetDescendants()
    ) do

        if part:IsA("BasePart") then

            if NoClipBackup[part] == nil then

                NoClipBackup[part] =
                    part.CanCollide
            end

            part.CanCollide =
                false
        end
    end
end

createToggle(
    DebugPage,
    "No Clip",
    "Disable character collision while enabled.",
    State.NoClipEnabled,
    function(enabled)

        State.NoClipEnabled =
            enabled

        if not enabled then
            restoreNoClip()
        end
    end
)

--========================================================
-- PERFORMANCE PAGE
--========================================================

createSectionTitle(
    PerformancePage,
    "Performance",
    "Reduce visual effects for testing"
)

local function restorePerformance()

    for object, properties in pairs(
        PerformanceBackup
    ) do

        if object
            and object.Parent then

            for property, value in pairs(
                properties
            ) do

                pcall(
                    function()
                        object[property] =
                            value
                    end
                )
            end
        end
    end

    table.clear(
        PerformanceBackup
    )
end

local function setPerformance(
    enabled
)

    State.PerformanceEnabled =
        enabled

    if not enabled then

        restorePerformance()

        return
    end

    for _, object in ipairs(
        game:GetDescendants()
    ) do

        if object:IsA(
            "ParticleEmitter"
        )
            or object:IsA(
                "Trail"
            )
            or object:IsA(
                "Beam"
            )
            or object:IsA(
                "Smoke"
            )
            or object:IsA(
                "Fire"
            )
            or object:IsA(
                "Sparkles"
            ) then

            PerformanceBackup[object] =
                PerformanceBackup[object]
                or {
                    Enabled =
                        object.Enabled,
                }

            object.Enabled =
                false

        elseif object:IsA(
            "PostEffect"
        ) then

            PerformanceBackup[object] =
                PerformanceBackup[object]
                or {
                    Enabled =
                        object.Enabled,
                }

            object.Enabled =
                false
        end
    end

    PerformanceBackup[Lighting] =
        PerformanceBackup[Lighting]
        or {
            GlobalShadows =
                Lighting.GlobalShadows,

            FogEnd =
                Lighting.FogEnd,

            EnvironmentDiffuseScale =
                Lighting.EnvironmentDiffuseScale,

            EnvironmentSpecularScale =
                Lighting.EnvironmentSpecularScale,
        }

    Lighting.GlobalShadows =
        false

    Lighting.FogEnd =
        100000

    Lighting.EnvironmentDiffuseScale =
        0

    Lighting.EnvironmentSpecularScale =
        0
end

createToggle(
