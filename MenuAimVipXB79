    {"RightLowerArm", "RightHand"},

    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},

    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"},
}

local R6_BONES = {
    {"Head", "Torso"},

    {"Torso", "Left Arm"},
    {"Torso", "Right Arm"},

    {"Torso", "Left Leg"},
    {"Torso", "Right Leg"},
}

local function createBoneLine(
    partA,
    partB,
    index
)

    if not partA
        or not partB then

        return {}
    end

    if not partA:IsA("BasePart")
        or not partB:IsA("BasePart") then

        return {}
    end

    local attachmentA =
        Instance.new(
            "Attachment"
        )

    attachmentA.Name =
        "BoneA_" .. index

    attachmentA.Parent =
        partA

    local attachmentB =
        Instance.new(
            "Attachment"
        )

    attachmentB.Name =
        "BoneB_" .. index

    attachmentB.Parent =
        partB

    local beam =
        Instance.new(
            "Beam"
        )

    beam.Name =
        "Bone_" .. index

    beam.Attachment0 =
        attachmentA

    beam.Attachment1 =
        attachmentB

    beam.FaceCamera = true

    beam.Width0 = 0.06
    beam.Width1 = 0.06

    beam.Color =
        ColorSequence.new(
            COLORS.Text
        )

    beam.Transparency =
        NumberSequence.new(
            0
        )

    beam.LightEmission = 1

    beam.Parent =
        ESPFolder

    return {
        beam,
        attachmentA,
        attachmentB,
    }
end

local function createBones(
    character
)

    if not State.ESPBonesEnabled then
        return {}
    end

    local boneList

    if character:FindFirstChild(
        "UpperTorso"
    ) then

        boneList =
            R15_BONES

    else

        boneList =
            R6_BONES
    end

    local objects = {}

    for index, pair in ipairs(
        boneList
    ) do

        local partA =
            character:FindFirstChild(
                pair[1]
            )

        local partB =
            character:FindFirstChild(
                pair[2]
            )

        if partA
            and partB then

            local created =
                createBoneLine(
                    partA,
                    partB,
                    index
                )

            for _, object in ipairs(
                created
            ) do

                table.insert(
                    objects,
                    object
                )
            end
        end
    end

    return objects
end

