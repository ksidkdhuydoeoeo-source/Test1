table.insert(
    Connections,
    RunService.RenderStepped:Connect(
        function()

            if Destroyed then
                return
            end

            -- SPEED

            if State.SpeedEnabled
                and Humanoid then

                Humanoid.WalkSpeed =
                    State.Speed
            end

            -- JUMP

            if State.JumpEnabled
                and Humanoid then

                Humanoid.UseJumpPower =
                    true

                Humanoid.JumpPower =
                    State.JumpPower
            end

            -- FLY

            if State.FlyEnabled then
                updateFly()
            end

            -- NOCLIP

            if State.NoClipEnabled then
                updateNoClip()
            end

            -- AIM

            if State.AimEnabled then

                local target =
                    getClosestTarget()

                if target then

                    local targetCFrame =
                        CFrame.lookAt(
                            Camera.CFrame.Position,
                            target.Position
                        )

                    Camera.CFrame =
                        Camera.CFrame:Lerp(
                            targetCFrame,
                            CONFIG.AimSmoothness
                        )
                end
            end

            -- FOV

            FOVCircle.Visible =
                State.AimEnabled

            FOVCircle.Size =
                UDim2.fromOffset(
                    State.AimFOV * 2,
                    State.AimFOV * 2
                )

            -- FLY MOBILE

            FlyControls.Visible =
                State.FlyEnabled
                and Main.Visible
        end
    )
)

--========================================================
-- LOADING ANIMATION
--========================================================

local function runLoading()

    local totalSteps = 100

    for percent = 1, totalSteps do

        if Destroyed then
            return
        end

        LoadingPercent.Text =
            tostring(percent)
            .. "%"

        ProgressFill.Size =
            UDim2.fromScale(
                percent / 100,
                1
            )

        if percent < 20 then

            LoadingStatus.Text =
                "Loading interface..."

        elseif percent < 40 then

            LoadingStatus.Text =
                "Preparing controls..."

        elseif percent < 60 then

            LoadingStatus.Text =
                "Preparing ESP system..."

        elseif percent < 80 then

            LoadingStatus.Text =
                "Preparing performance..."

        elseif percent < 100 then

            LoadingStatus.Text =
                "Finalizing interface..."

        else

            LoadingStatus.Text =
                "Complete."
        end

        task.wait(
            CONFIG.LoadingTime
            / totalSteps
        )
    end

    task.wait(
        0.25
    )

    -- Fade loading out

    local fadeInfo =
        TweenInfo.new(
            0.35,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        )

    local fadeObjects = {
        Loading,
        LoadingInner,
        LoadingLogo,
        LoadingPercent,
        LoadingStatus,
        ProgressBackground,
        ProgressFill,
    }

    for _, object in ipairs(
        fadeObjects
    ) do

        if object:IsA("Frame") then

            tween(
                object,
                fadeInfo,
                {
                    BackgroundTransparency =
                        1
                }
            ):Play()

        elseif object:IsA(
            "TextLabel"
        ) then

            tween(
                object,
                fadeInfo,
                {
                    TextTransparency =
                        1
                }
            ):Play()
        end
    end

    task.wait(
        0.40
    )

    safeDestroy(
        Loading
    )

    -- Show menu only after loading
    Main.Visible =
        true

    OpenButton.Visible =
        false
end

