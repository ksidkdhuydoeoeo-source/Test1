local function stopFly()

    if FlyVelocity then
        safeDestroy(
            FlyVelocity
        )

        FlyVelocity = nil
    end

    if FlyGyro then
        safeDestroy(
            FlyGyro
        )

        FlyGyro = nil
    end

    if Humanoid then
        Humanoid.AutoRotate = true
        Humanoid.PlatformStand = false
    end
end

local function startFly()

    if not RootPart
        or not Humanoid then

        return
    end

    stopFly()

    Humanoid.AutoRotate = false
    Humanoid.PlatformStand = true

    FlyVelocity =
        Instance.new(
            "BodyVelocity"
        )

    FlyVelocity.Name =
        "XiBoDzV6_FlyVelocity"

    FlyVelocity.MaxForce =
        Vector3.new(
            math.huge,
            math.huge,
            math.huge
        )

    FlyVelocity.P = 5000

    FlyVelocity.Velocity =
        Vector3.zero

    FlyVelocity.Parent =
        RootPart

    FlyGyro =
        Instance.new(
            "BodyGyro"
        )

    FlyGyro.Name =
        "XiBoDzV6_FlyGyro"

    FlyGyro.MaxTorque =
        Vector3.new(
            math.huge,
            math.huge,
            math.huge
        )

    FlyGyro.P = 5000

    FlyGyro.CFrame =
        RootPart.CFrame

    FlyGyro.Parent =
        RootPart
end

local function updateFly()

    if not State.FlyEnabled
        or not RootPart
        or not Humanoid
        or not FlyVelocity
        or not FlyGyro then

        return
    end

    local direction =
        Humanoid.MoveDirection

    local velocity =
        direction
        * State.FlySpeed

    if State.FlyUp then

        velocity +=
            Vector3.new(
                0,
                State.FlySpeed,
                0
            )
    end

    if State.FlyDown then

        velocity -=
            Vector3.new(
                0,
                State.FlySpeed,
                0
            )
    end

    FlyVelocity.Velocity =
        velocity

    local look =
        Camera.CFrame.LookVector

    FlyGyro.CFrame =
        CFrame.lookAt(
            RootPart.Position,
            RootPart.Position + look
        )
end

