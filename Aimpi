-- Bypass Anti-Cheat
local function BypassAntiCheat()
    -- Anti-Cheat Detection Bypass
    local mt = getrawmetatable(game)
    local oldIndex = mt.__index
    setreadonly(mt, false)
    
    mt.__index = newcclosure(function(self, key)
        if tostring(key) == "WalkSpeed" or tostring(key) == "JumpPower" then
            return oldIndex(self, key)
        end
        return oldIndex(self, key)
    end)
    
    -- Hide from detection
    local CoreGui = game:GetService("CoreGui")
    local namecall
    namecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FindFirstChild" or method == "WaitForChild" then
            local args = {...}
            if typeof(args[1]) == "string" and args[1]:lower():find("delta") then
                return nil
            end
        end
        return namecall(self, ...)
    end))
    
    -- Anti Remote Spy
    local oldRemoteFunction = Instance.new("RemoteFunction")
    local oldRemoteEvent = Instance.new("RemoteEvent")
    
    -- Hook FireServer để tránh detection
    local oldFireServer = oldRemoteEvent.FireServer
    oldRemoteEvent.FireServer = function(self, ...)
        local success, result = pcall(oldFireServer, self, ...)
        if not success then
            warn("Blocked by anti-cheat")
            return
        end
        return result
    end
    
    print("[Delta UI] Anti-Cheat Bypass Active")
end

