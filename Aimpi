-- Drawing Cache System
local DrawingCache = {}
local function GetDrawing(className, properties)
    local cacheKey = className
    if not DrawingCache[cacheKey] then
        DrawingCache[cacheKey] = {}
    end
    
    local drawing = Drawing.new(className)
    for prop, value in pairs(properties or {}) do
        pcall(function()
            drawing[prop] = value
        end)
    end
    return drawing
end

