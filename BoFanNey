--==================================================
-- LOADING
--==================================================

local function finishLoading()
    if Destroyed or LoadingComplete then
        return
    end

    LoadingComplete = true

    safeCall(function()
        Percent.Text = "100%"
        ProgressFill.Size = UDim2.new(1, 0, 1, 0)
        LoadingStatus.Text = "Complete"
    end)

    Loading.Visible = false
    Main.Visible = true
    OpenButton.Visible = false

    updateScale()
    selectTab("Movement")

    -- Menu is made visible BEFORE any optional animation.
    safeCall(function()
        Main.BackgroundTransparency = 1

        local tween = TweenService:Create(
            Main,
            TweenInfo.new(
                0.25,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                BackgroundTransparency = 0
            }
        )

        tween:Play()
    end)
end

local function runLoading()
    Main.Visible = false
    OpenButton.Visible = false
    Loading.Visible = true

    for progress = 1, 100 do
        if Destroyed or LoadingComplete then
            return
        end

        safeCall(function()
            Percent.Text =
                tostring(progress) .. "%"

            if progress < 25 then
                LoadingStatus.Text =
                    "Preparing interface..."
            elseif progress < 50 then
                LoadingStatus.Text =
                    "Loading modules..."
            elseif progress < 75 then
                LoadingStatus.Text =
                    "Initializing controls..."
            elseif progress < 100 then
                LoadingStatus.Text =
                    "Finalizing..."
            else
                LoadingStatus.Text =
                    "Complete"
            end

            ProgressFill.Size =
                UDim2.new(
                    progress / 100,
                    0,
                    1,
                    0
                )
        end)

        task.wait(CONFIG.LoadingTime / 100)
    end

    task.wait(0.1)

    finishLoading()
end

-- Fallback watchdog:
-- If any non-fatal UI operation interrupts the loading loop,
-- the menu still becomes visible.
task.delay(CONFIG.LoadingTime + 1.25, function()
    if not Destroyed and not LoadingComplete then
        warn("[XiBoDzV6.5] Loading watchdog opened the menu.")
        finishLoading()
    end
end)

