local function updateScale()
    local camera = getCamera()

    if not camera then
        return
    end

    local viewport = camera.ViewportSize

    local maxWidth = viewport.X - 30
    local maxHeight = viewport.Y - 30

    local scaleX = maxWidth / CurrentWidth
    local scaleY = maxHeight / CurrentHeight

    local scale = math.min(1, scaleX, scaleY)

    if scale < 0.55 then
        scale = 0.55
    end

    UIScale.Scale = scale
end

local function connectCamera()
    if CameraViewportConnection then
        pcall(function()
            CameraViewportConnection:Disconnect()
        end)

        CameraViewportConnection = nil
    end

    local camera = getCamera()

    if not camera then
        return
    end

    CameraViewportConnection =
        camera:GetPropertyChangedSignal("ViewportSize"):Connect(
            updateScale
        )

    updateScale()
end

connect(Workspace:GetPropertyChangedSignal("CurrentCamera"), function()
    task.defer(connectCamera)
end)

