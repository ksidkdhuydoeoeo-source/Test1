local function selectTab(name)
    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
    end

    for buttonName, button in pairs(TabButtons) do
        if buttonName == name then
            button.BackgroundColor3 = Color3.fromRGB(32, 32, 36)
            button.TextColor3 = Color3.fromRGB(245, 245, 248)
        else
            button.BackgroundColor3 = Color3.fromRGB(18, 18, 21)
            button.TextColor3 = Color3.fromRGB(145, 145, 150)
        end
    end
end

for name, button in pairs(TabButtons) do
    connect(button.Activated, function()
        selectTab(name)
    end)
end

