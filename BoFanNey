createSection(MovementPage, "Movement")

createToggle(
    MovementPage,
    "Speed",
    false,
    function(enabled)
        State.SpeedEnabled = enabled

        local humanoid = getHumanoid()

        if enabled and humanoid then
            if OriginalWalkSpeed[humanoid] == nil then
                OriginalWalkSpeed[humanoid] = humanoid.WalkSpeed
            end

            humanoid.WalkSpeed = State.Speed
        elseif humanoid then
            humanoid.WalkSpeed = OriginalWalkSpeed[humanoid] or 16
        end
    end
)

createSlider(
    MovementPage,
    "Speed Value",
    CONFIG.SpeedMin,
    CONFIG.SpeedMax,
    CONFIG.SpeedDefault,
    function(value)
        State.Speed = value

        if State.SpeedEnabled then
            local humanoid = getHumanoid()

            if humanoid then
                humanoid.WalkSpeed = value
            end
        end
    end
)

createToggle(
    MovementPage,
    "High Jump",
    false,
    function(enabled)
        State.JumpEnabled = enabled

        local humanoid = getHumanoid()

        if enabled and humanoid then
            if OriginalJumpPower[humanoid] == nil then
                OriginalJumpPower[humanoid] = humanoid.JumpPower
            end

            humanoid.UseJumpPower = true
            humanoid.JumpPower = State.JumpPower
        elseif humanoid then
            humanoid.JumpPower = OriginalJumpPower[humanoid] or 50
        end
    end
)

createSlider(
    MovementPage,
    "Jump Power",
    CONFIG.JumpMin,
    CONFIG.JumpMax,
    CONFIG.JumpDefault,
    function(value)
        State.JumpPower = value

        if State.JumpEnabled then
            local humanoid = getHumanoid()

            if humanoid then
                humanoid.UseJumpPower = true
                humanoid.JumpPower = value
            end
        end
    end
)

createToggle(
    MovementPage,
    "Fly",
    false,
    function(enabled)
        State.FlyEnabled = enabled

        local character = getCharacter()
        local humanoid = getHumanoid()

        if not enabled then
            if FlyVelocity then
                FlyVelocity:Destroy()
                FlyVelocity = nil
            end

            if FlyGyro then
                FlyGyro:Destroy()
                FlyGyro = nil
            end

            if humanoid then
                humanoid.PlatformStand = false
            end

            State.FlyUp = false
            State.FlyDown = false

            return
        end

        if character and humanoid then
            humanoid.PlatformStand = true
        end
    end
)

createSlider(
    MovementPage,
    "Fly Speed",
