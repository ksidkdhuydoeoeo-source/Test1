local function createESP(player)
    if Destroyed then
        return
    end

    if player == LocalPlayer then
        return
    end

    if not (
        State.ESPNameEnabled
        or State.ESPBonesEnabled
        or State.ESPDirectionsEnabled
    ) then
        return
    end

    local character = player.Character

    if not character then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 then
        return
    end

    local container = Instance.new("Folder")
    container.Name = tostring(player.UserId)
    container.Parent = ESPFolder

    createNameESP(player, character, container)
    createBoneESP(player, character, container)
    createDirectionESP(character, container)
