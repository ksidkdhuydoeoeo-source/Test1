local function applyMenuSize(width, height)
    CurrentWidth = math.clamp(
        math.floor(width),
        CONFIG.MinWidth,
        CONFIG.MaxWidth
    )

    CurrentHeight = math.clamp(
        math.floor(height),
        CONFIG.MinHeight,
        CONFIG.MaxHeight
    )

    Main.Size = UDim2.fromOffset(CurrentWidth, CurrentHeight)
end

