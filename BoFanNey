connect(RunService.RenderStepped, function()
    if Destroyed then
        return
    end

    local character = getCharacter()
    local humanoid = getHumanoid()
    local root = getRoot()

    --==============================================
    -- SPEED
    --==============================================

    if State.SpeedEnabled and humanoid then
        humanoid.WalkSpeed = State.Speed
    end

    --==============================================
    -- JUMP
    --==============================================

    if State.JumpEnabled and humanoid then
        humanoid.UseJumpPower = true
        humanoid.JumpPower = State.JumpPower
    end

    --==============================================
    -- NOCLIP
    --==============================================

    if State.NoClipEnabled and character then
        for _, object in ipairs(character:GetDescendants()) do
            if object:IsA("BasePart") then
                if OriginalCanCollide[object] == nil then
                    OriginalCanCollide[object] =
                        object.CanCollide
                end

                object.CanCollide = false
            end
        end
    end

    --==============================================
    -- FLY
    --==============================================

    if State.FlyEnabled then
        if not root or not humanoid then
            return
        end

        if not FlyVelocity or FlyVelocity.Parent ~= root then
            setupFly()
        end

        if FlyVelocity and FlyGyro then
            local camera = getCamera()

            if camera then
                local moveDirection =
                    humanoid.MoveDirection

                local horizontalVelocity = Vector3.zero

                if moveDirection.Magnitude > 0.01 then
                    horizontalVelocity =
                        moveDirection.Unit * State.FlySpeed
                end

                local verticalVelocity = 0

                if State.FlyUp then
                    verticalVelocity += State.FlySpeed
                end

                if State.FlyDown then
                    verticalVelocity -= State.FlySpeed
                end

                FlyVelocity.Velocity =
                    horizontalVelocity
                    + Vector3.new(
                        0,
                        verticalVelocity,
                        0
                    )

                -- Face the same horizontal direction as camera.
                local lookVector = camera.CFrame.LookVector

                local flatLook = Vector3.new(
                    lookVector.X,
                    0,
                    lookVector.Z
                )

                if flatLook.Magnitude > 0.01 then
                    FlyGyro.CFrame =
                        CFrame.lookAt(
                            root.Position,
                            root.Position + flatLook.Unit
                        )
                end
            end

            humanoid.PlatformStand = true
        end
    end

    --==============================================
    -- AIM
    --==============================================

    if State.AimEnabled then
        local camera = getCamera()

        if camera then
            local viewport = camera.ViewportSize

            FOVCircle.Position =
                UDim2.fromOffset(
                    viewport.X / 2,
                    viewport.Y / 2
                )

            FOVCircle.Size =
                UDim2.fromOffset(
                    State.AimFOV * 2,
                    State.AimFOV * 2
                )

            local target = getAimTarget()

            if target then
                local targetCharacter =
                    target.Character

                local targetHead =
                    targetCharacter
                    and targetCharacter:FindFirstChild("Head")

                if targetHead then
                    local desired =
                        CFrame.lookAt(
                            camera.CFrame.Position,
                            targetHead.Position
                        )

                    camera.CFrame =
                        camera.CFrame:Lerp(
                            desired,
                            CONFIG.AimSmoothness
                        )
                end
            end
        end
    end
end)

