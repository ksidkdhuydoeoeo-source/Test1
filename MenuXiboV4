--// =========================================================

LocalPlayer.CharacterAdded:Connect(function()
    OriginalWalkSpeed = nil
    OriginalJumpPower = nil
    OriginalUseJumpPower = nil

    table.clear(NoClipBackup)

    task.wait(0.5)

    if State.SpeedEnabled then
        enableSpeed()
    end

    if State.JumpEnabled then
        enableJump()
    end

    if State.NoClipEnabled then
        enableNoClip()
    end
end)

--// =========================================================
--// MAIN LOOP
--// =========================================================

local espTimer = 0

RunService.RenderStepped:Connect(function(deltaTime)

    -- Speed
    if State.SpeedEnabled then
        if not previousSpeedEnabled then
            enableSpeed()
        end

        local humanoid = getHumanoid()

        if humanoid then
            humanoid.WalkSpeed = State.Speed
        end
    elseif previousSpeedEnabled then
        disableSpeed()
    end

    previousSpeedEnabled = State.SpeedEnabled

    -- High Jump
    if State.JumpEnabled then
        if not previousJumpEnabled then
            enableJump()
        end

        local humanoid = getHumanoid()

        if humanoid then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = State.JumpPower
        end
    elseif previousJumpEnabled then
        disableJump()
    end

    previousJumpEnabled = State.JumpEnabled

    -- No Clip
    if State.NoClipEnabled then
        enableNoClip()
    elseif previousNoClipEnabled then
        disableNoClip()
    end

    previousNoClipEnabled = State.NoClipEnabled

    -- Aim
    updateAim()

    -- FOV circle
    FOVCircle.Visible = State.AimEnabled

    if State.AimEnabled then
        FOVCircle.Size =
            UDim2.fromOffset(
                State.AimFOV * 2,
                State.AimFOV * 2
            )
    end

    -- ESP throttled
    espTimer += deltaTime

    if espTimer >= 0.15 then
        espTimer = 0
        refreshESP()
    end
end)

--// =========================================================
--// CLEANUP
--// =========================================================

ScreenGui.Destroying:Connect(function()
    disableSpeed()
    disableJump()
    disableNoClip()
    disablePerformance()

    for player in pairs(ESPObjects) do
        removeESP(player)
    end
end)

