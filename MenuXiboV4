local function toggle(title, initialValue, callback)
    local button = create("TextButton", {
        Size = UDim2.new(1, -4, 0, 44),
        BackgroundTransparency = 0.08,
        Text = "",
        AutoButtonColor = true,
    }, Scroll)

    create("UICorner", {
