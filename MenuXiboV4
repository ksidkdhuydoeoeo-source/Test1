    }, button)

    local label = create("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.fromOffset(14, 0),
        BackgroundTransparency = 1,
        Text = title,
        TextSize = 14,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, button)

    local stateLabel = create("TextLabel", {
        Size = UDim2.fromOffset(55, 30),
        Position = UDim2.new(1, -62, 0.5, -15),
        BackgroundTransparency = 1,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
    }, button)

    local value = initialValue

    local function refresh()
        stateLabel.Text = value and "ON" or "OFF"
    end

    button.MouseButton1Click:Connect(function()
        value = not value
        refresh()
        callback(value)
    end)

    refresh()

    return button
end

local function slider(title, minimum, maximum, initial, callback)
    local holder = create("Frame", {
        Size = UDim2.new(1, -4, 0, 62),
        BackgroundTransparency = 0.08,
    }, Scroll)

    create("UICorner", {
        CornerRadius = UDim.new(0, 10),
    }, holder)

    local label = create("TextLabel", {
        Size = UDim2.new(1, -25, 0, 24),
        Position = UDim2.fromOffset(12, 5),
        BackgroundTransparency = 1,
        Text = title,
        TextSize = 13,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, holder)

    local valueLabel = create("TextLabel", {
        Size = UDim2.fromOffset(55, 24),
        Position = UDim2.new(1, -65, 0, 5),
        BackgroundTransparency = 1,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, holder)

    local bar = create("Frame", {
        Size = UDim2.new(1, -24, 0, 8),
        Position = UDim2.fromOffset(12, 39),
        BackgroundTransparency = 0.15,
        Active = true,
    }, holder)

    create("UICorner", {
        CornerRadius = UDim.new(1, 0),
    }, bar)

    local fill = create("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundTransparency = 0,
    }, bar)

    create("UICorner", {
        CornerRadius = UDim.new(1, 0),
    }, fill)

    local current = initial
    local sliding = false

    local function setValueFromX(x)
        local percent =
            math.clamp(
                (x - bar.AbsolutePosition.X)
                / bar.AbsoluteSize.X,
                0,
                1
            )

        current =
            math.floor(
                minimum
                + (maximum - minimum) * percent
                + 0.5
            )

        fill.Size = UDim2.fromScale(percent, 1)
        valueLabel.Text = tostring(current)

        callback(current)
    end

    local function begin(input)
        sliding = true
        setValueFromX(input.Position.X)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            begin(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not sliding then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            setValueFromX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)

    local percent =
        math.clamp(
            (initial - minimum)
            / (maximum - minimum),
            0,
            1
        )

    fill.Size = UDim2.fromScale(percent, 1)
    valueLabel.Text = tostring(initial)

    return holder
end

