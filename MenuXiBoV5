--============================================================
-- PERFORMANCE
--============================================================

local PerformanceBackup = {}
local PerformanceConnection = nil

local function rememberPerformance(
    object,
    property
)
    if not PerformanceBackup[object] then
        PerformanceBackup[object] = {}
    end

    if PerformanceBackup[object][property] == nil then
        PerformanceBackup[object][property] =
            object[property]
    end
end

local function optimizeObject(object)
    if object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Beam")
        or object:IsA("Smoke")
        or object:IsA("Fire")
        or object:IsA("Sparkles") then

        rememberPerformance(
            object,
            "Enabled"
        )

        object.Enabled = false

    elseif object:IsA("BloomEffect")
        or object:IsA("BlurEffect")
        or object:IsA("DepthOfFieldEffect")
        or object:IsA("SunRaysEffect")
        or object:IsA("ColorCorrectionEffect") then

        rememberPerformance(
            object,
            "Enabled"
        )

        object.Enabled = false
    end
end

local function enablePerformance()
    rememberPerformance(
        Lighting,
        "GlobalShadows"
    )

    rememberPerformance(
        Lighting,
        "EnvironmentDiffuseScale"
    )

    rememberPerformance(
        Lighting,
        "EnvironmentSpecularScale"
    )

    rememberPerformance(
        Lighting,
        "FogEnd"
    )

    Lighting.GlobalShadows = false
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0
    Lighting.FogEnd = 100000

    for _, object in ipairs(
        game:GetDescendants()
    ) do
        optimizeObject(object)
    end

    if PerformanceConnection then
        PerformanceConnection:Disconnect()
    end

    PerformanceConnection =
        game.DescendantAdded:Connect(
            function(object)
                if State.PerformanceEnabled then
                    optimizeObject(object)
                end
            end
        )
end

local function disablePerformance()
    if PerformanceConnection then
        PerformanceConnection:Disconnect()
        PerformanceConnection = nil
    end

    for object, properties in pairs(
        PerformanceBackup
    ) do

        if object and object.Parent then
            for property, value in pairs(
                properties
            ) do

                pcall(function()
                    object[property] = value
                end)
            end
        end
    end

    table.clear(PerformanceBackup)
end

