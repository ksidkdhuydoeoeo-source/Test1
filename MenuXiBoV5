local function createSlider(
    parent,
    title,
    minimum,
    maximum,
    getter,
    setter
)
    local holder = create("Frame", {
        Size = UDim2.new(1, 0, 0, 66),

        BackgroundColor3 = COLORS.Panel,
        BorderSizePixel = 0,
    }, parent)

    create("UICorner", {
        CornerRadius = UDim.new(0, 10),
    }, holder)

    create("UIStroke", {
        Color = COLORS.Border,
        Thickness = 1,
        Transparency = 0.25,
    }, holder)

    create("TextLabel", {
        Size = UDim2.new(1, -80, 0, 24),
        Position = UDim2.fromOffset(14, 7),

        BackgroundTransparency = 1,

        Text = title,
        TextColor3 = COLORS.Text,

        Font = Enum.Font.GothamMedium,
        TextSize = 12,

        TextXAlignment = Enum.TextXAlignment.Left,
    }, holder)

    local valueLabel = create("TextLabel", {
        Size = UDim2.fromOffset(55, 24),
        Position = UDim2.new(1, -68, 0, 7),

        BackgroundTransparency = 1,

        TextColor3 = COLORS.Text,

        Font = Enum.Font.GothamBold,
        TextSize = 12,

        TextXAlignment = Enum.TextXAlignment.Right,
    }, holder)

    local bar = create("Frame", {
        Size = UDim2.new(1, -28, 0, 7),
        Position = UDim2.fromOffset(14, 43),

        BackgroundColor3 = COLORS.ToggleOff,
        BorderSizePixel = 0,

        Active = true,
    }, holder)

    create("UICorner", {
        CornerRadius = UDim.new(1, 0),
    }, bar)

    local fill = create("Frame", {
        Size = UDim2.fromScale(0, 1),

        BackgroundColor3 = COLORS.Accent,
        BorderSizePixel = 0,
    }, bar)

    create("UICorner", {
        CornerRadius = UDim.new(1, 0),
    }, fill)

    local sliding = false

    local function setFromX(x)
        local width = bar.AbsoluteSize.X

        if width <= 0 then
            return
        end

        local percent = math.clamp(
            (x - bar.AbsolutePosition.X) / width,
            0,
            1
        )

        local value = math.floor(
            minimum
            + (maximum - minimum) * percent
            + 0.5
        )

        setter(value)

        valueLabel.Text = tostring(value)
        fill.Size = UDim2.fromScale(percent, 1)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            sliding = true
            setFromX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not sliding then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            setFromX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            sliding = false
        end
    end)

    local function refresh()
        local value = getter()

        local percent = math.clamp(
            (value - minimum) / (maximum - minimum),
            0,
            1
        )

        valueLabel.Text = tostring(value)
        fill.Size = UDim2.fromScale(percent, 1)
    end

    refresh()

    return holder
end

--============================================================
-- SPEED
--============================================================

local OriginalWalkSpeed = nil

local function enableSpeed()
    local humanoid = getHumanoid()

    if not humanoid then
        return
    end

    if OriginalWalkSpeed == nil then
        OriginalWalkSpeed = humanoid.WalkSpeed
    end

    humanoid.WalkSpeed = State.Speed
end

local function disableSpeed()
    local humanoid = getHumanoid()

    if humanoid then
        humanoid.WalkSpeed =
            OriginalWalkSpeed or 16
    end

    OriginalWalkSpeed = nil
end

--============================================================
-- JUMP
--============================================================

local OriginalJumpPower = nil
local OriginalUseJumpPower = nil

local function enableJump()
    local humanoid = getHumanoid()

    if not humanoid then
        return
    end

    if OriginalJumpPower == nil then
        OriginalJumpPower = humanoid.JumpPower
        OriginalUseJumpPower =
            humanoid.UseJumpPower
    end

    humanoid.UseJumpPower = true
    humanoid.JumpPower = State.JumpPower
end

local function disableJump()
    local humanoid = getHumanoid()

    if humanoid then
        if OriginalJumpPower ~= nil then
            humanoid.JumpPower =
                OriginalJumpPower
        end

        if OriginalUseJumpPower ~= nil then
            humanoid.UseJumpPower =
                OriginalUseJumpPower
        end
    end

    OriginalJumpPower = nil
    OriginalUseJumpPower = nil
end

--============================================================
-- FLY
--============================================================

local FlyVelocity = nil
local FlyOrientation = nil

local FlyUp = false
local FlyDown = false

local function cleanupFlyObjects()
    if FlyVelocity then
        pcall(function()
            FlyVelocity:Destroy()
        end)

        FlyVelocity = nil
    end

    if FlyOrientation then
        pcall(function()
            FlyOrientation:Destroy()
        end)

        FlyOrientation = nil
    end
end

local function stopFly()
    cleanupFlyObjects()

    FlyUp = false
    FlyDown = false

    local humanoid = getHumanoid()

    if humanoid then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
    end
end

local function startFly()
    stopFly()

    local root = getRoot()
    local humanoid = getHumanoid()

    if not root or not humanoid then
        return
    end

    humanoid.PlatformStand = true
    humanoid.AutoRotate = false

    FlyVelocity = Instance.new("BodyVelocity")
    FlyVelocity.Name = "XiBoDzV5_FlyVelocity"

    FlyVelocity.MaxForce =
        Vector3.new(
            math.huge,
            math.huge,
            math.huge
        )

    FlyVelocity.P = 10000
    FlyVelocity.Velocity = Vector3.zero

    FlyVelocity.Parent = root

    FlyOrientation = Instance.new("BodyGyro")
    FlyOrientation.Name = "XiBoDzV5_FlyOrientation"

    FlyOrientation.MaxTorque =
        Vector3.new(
            math.huge,
            math.huge,
            math.huge
        )

    FlyOrientation.P = 10000
    FlyOrientation.D = 500
    FlyOrientation.CFrame = root.CFrame

    FlyOrientation.Parent = root
end

local function updateFly()
    if not State.FlyEnabled then
        return
    end

    local root = getRoot()
    local humanoid = getHumanoid()
    local camera = workspace.CurrentCamera

    if not root or not humanoid or not camera then
        return
    end

    if not FlyVelocity or not FlyOrientation then
        startFly()
        return
    end

    local moveDirection =
        humanoid.MoveDirection

    local velocity = Vector3.zero

    if moveDirection.Magnitude > 0.01 then
        velocity =
            moveDirection.Unit
            * State.FlySpeed
    end

    if FlyUp then
        velocity +=
            Vector3.yAxis
            * State.FlySpeed
    end

    if FlyDown then
        velocity -=
            Vector3.yAxis
            * State.FlySpeed
    end

    FlyVelocity.Velocity = velocity

    local lookVector =
        camera.CFrame.LookVector

    local flatLook = Vector3.new(
        lookVector.X,
        0,
        lookVector.Z
    )

    if flatLook.Magnitude > 0.01 then
        FlyOrientation.CFrame =
            CFrame.lookAt(
                root.Position,
                root.Position + flatLook.Unit
            )
    end
end

local function setFlyEnabled(enabled)
    State.FlyEnabled = enabled

    if enabled then
        startFly()
    else
        stopFly()
    end
end

