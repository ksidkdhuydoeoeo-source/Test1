    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
    end

    for tabName, button in pairs(Tabs) do
        local selected = tabName == name

        button.BackgroundColor3 =
            selected
            and COLORS.Panel2
            or COLORS.Sidebar

        local stroke =
            button:FindFirstChild("SelectedStroke")

        if stroke then
            stroke.Transparency =
                selected and 0 or 1
        end
    end
end

