--============================================================
-- RUNTIME
--============================================================

local espTimer = 0

RunService.RenderStepped:Connect(function(deltaTime)

    ----------------------------------------------------------
    -- SPEED
    ----------------------------------------------------------

    if State.SpeedEnabled then
        local humanoid = getHumanoid()

        if humanoid then
            if OriginalWalkSpeed == nil then
                OriginalWalkSpeed =
                    humanoid.WalkSpeed
            end

            humanoid.WalkSpeed =
                State.Speed
        end
    end

    ----------------------------------------------------------
    -- JUMP
    ----------------------------------------------------------

    if State.JumpEnabled then
        local humanoid = getHumanoid()

        if humanoid then
            if OriginalJumpPower == nil then
                OriginalJumpPower =
                    humanoid.JumpPower

                OriginalUseJumpPower =
                    humanoid.UseJumpPower
            end

            humanoid.UseJumpPower = true
            humanoid.JumpPower =
                State.JumpPower
        end
    end

    ----------------------------------------------------------
    -- FLY
    ----------------------------------------------------------

    if State.FlyEnabled then
        updateFly()
    end

    ----------------------------------------------------------
    -- NO CLIP
    ----------------------------------------------------------

    if State.NoClipEnabled then
        enableNoClip()
    end

    ----------------------------------------------------------
    -- AIM
    ----------------------------------------------------------

    if State.AimEnabled then
        local camera =
            workspace.CurrentCamera

        if camera then
            local target =
                getClosestTarget()

            if target then
                local desired =
                    CFrame.lookAt(
                        camera.CFrame.Position,
                        target.Position
                    )

                camera.CFrame =
                    camera.CFrame:Lerp(
                        desired,
                        CONFIG.AimSmoothness
                    )
            end
        end
    end

    ----------------------------------------------------------
    -- FOV
    ----------------------------------------------------------

    FOVCircle.Visible =
        State.AimEnabled

    if State.AimEnabled then
        FOVCircle.Size =
            UDim2.fromOffset(
                State.AimFOV * 2,
                State.AimFOV * 2
            )
    end

    ----------------------------------------------------------
    -- MOBILE FLY BUTTONS
    ----------------------------------------------------------

    FlyControls.Visible =
        State.FlyEnabled

    ----------------------------------------------------------
    -- ESP
    ----------------------------------------------------------

    espTimer += deltaTime

    if espTimer >= CONFIG.ESPRefresh then
        espTimer = 0

        if State.ESPEnabled then
            for _, player in ipairs(
                Players:GetPlayers()
            ) do
                createESP(player)
            end
        end
    end
end)

