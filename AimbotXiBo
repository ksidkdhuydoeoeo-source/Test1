local function removeESP(player)
	local data = ESPObjects[player]

	if data then
		for _, object in pairs(data) do
			if typeof(object) == "Instance" then
				object:Destroy()
			end
		end

		ESPObjects[player] = nil
	end
end

local function createESP(player)
	if player == LocalPlayer then
		return
	end

	removeESP(player)

	local character = player.Character
	if not character then
		return
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "XiBoEnemyHighlight"
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.FillTransparency = 0.78
	highlight.OutlineTransparency = 0
	highlight.FillColor = Color3.fromRGB(220, 60, 70)
	highlight.OutlineColor = Color3.fromRGB(255, 130, 130)
	highlight.Adornee = character
	highlight.Parent = character

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "XiBoEnemyInfo"
	billboard.Size = UDim2.fromOffset(150, 38)
	billboard.StudsOffset = Vector3.new(0, 3.2, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 500
	billboard.Adornee =
		character:FindFirstChild("Head")
		or character:FindFirstChild("HumanoidRootPart")
	billboard.Parent = PlayerGui

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
	frame.BackgroundTransparency = 0.22
	frame.BorderSizePixel = 0
	frame.Parent = billboard

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, -10, 1, 0)
	nameLabel.Position = UDim2.fromOffset(5, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = player.DisplayName
	nameLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
	nameLabel.TextSize = 13
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextStrokeTransparency = 0.7
	nameLabel.Parent = frame

	ESPObjects[player] = {
		Highlight = highlight,
		Billboard = billboard,
	}
end

local function refreshESP()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			if State.ESPEnabled and isEnemy(player) then
				if not ESPObjects[player]
					or not ESPObjects[player].Highlight
					or ESPObjects[player].Highlight.Parent
						~= player.Character then

					createESP(player)
				end
			else
				removeESP(player)
			end
		end
	end
end

Players.PlayerRemoving:Connect(removeESP)

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(0.2)

		if State.ESPEnabled and isEnemy(player) then
			createESP(player)
		end
	end)
end)

--========================================================
-- PERFORMANCE MODE
--========================================================

local originalLighting = {}

local function enablePerformanceMode()
	if State.PerformanceEnabled then
		return
	end

	State.PerformanceEnabled = true

	-- Save only settings that we change.
	originalLighting.GlobalShadows = Lighting.GlobalShadows
	originalLighting.FogEnd = Lighting.FogEnd
	originalLighting.EnvironmentDiffuseScale =
		Lighting.EnvironmentDiffuseScale
	originalLighting.EnvironmentSpecularScale =
		Lighting.EnvironmentSpecularScale

	Lighting.GlobalShadows = false
	Lighting.FogEnd = 100000
	Lighting.EnvironmentDiffuseScale = 0
	Lighting.EnvironmentSpecularScale = 0

	-- Disable expensive local visual effects.
	for _, object in ipairs(Workspace:GetDescendants()) do
		if object:IsA("ParticleEmitter")
			or object:IsA("Trail")
			or object:IsA("Beam") then

			object:SetAttribute(
				"XiBoOriginalEnabled",
				object.Enabled
			)

			object.Enabled = false
		end
	end
end

local function disablePerformanceMode()
	if not State.PerformanceEnabled then
		return
	end

	State.PerformanceEnabled = false

	Lighting.GlobalShadows =
		originalLighting.GlobalShadows

	Lighting.FogEnd =
		originalLighting.FogEnd

	Lighting.EnvironmentDiffuseScale =
		originalLighting.EnvironmentDiffuseScale

	Lighting.EnvironmentSpecularScale =
		originalLighting.EnvironmentSpecularScale

	for _, object in ipairs(Workspace:GetDescendants()) do
		local original =
			object:GetAttribute("XiBoOriginalEnabled")

		if original ~= nil then
			if object:IsA("ParticleEmitter")
				or object:IsA("Trail")
				or object:IsA("Beam") then

				object.Enabled = original
			end

			object:SetAttribute(
				"XiBoOriginalEnabled",
				nil
			)
		end
	end
end

