--========================================================
-- AIM LOOP
--========================================================

RunService.RenderStepped:Connect(function()
	if not State.AimEnabled then
		return
	end

	local camera = Workspace.CurrentCamera

	if not camera then
		return
	end

	local target = getClosestVisibleEnemy()

	if target then
		local desired =
			CFrame.lookAt(
				camera.CFrame.Position,
				target.Position
			)

		camera.CFrame =
			camera.CFrame:Lerp(
				desired,
				Config.AimSmoothness
			)
	end
end)

--========================================================
-- ESP LOOP
--========================================================

RunService.Heartbeat:Connect(function()
	local now = os.clock()

	if now - LastESPUpdate <
			Config.ESPUpdateInterval then
		return
	end

	LastESPUpdate = now

	if State.ESPEnabled then
		refreshESP()
	end
end)

